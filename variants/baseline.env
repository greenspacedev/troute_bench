# Baseline: the RA's code (alk05), pinned by commit SHA. routing-comparison is
# updates_for_da plus one commit enabling medium range (greenspacedev medium-range).
#
# Each variant names one source (git URL or local clone path) and one ref (commit SHA,
# branch or tag) per component. build.sh resolves refs to SHAs, builds the images, and
# records exactly what went into them in builds/<variant>.json.
DESCRIPTION="RA's pipeline (alk05, 2026-11-13) + medium range enabled"

# routing-comparison-nwm-nextgen-troute: preprocess + postprocess scripts and Dockerfiles
# medium-range = alk05 updates_for_da (10e6b01) + 8b67fd4: ensemble member 1 for
# FORECAST_TYPE 2, rename pattern matches medium_range channel_rt_1 files. No other changes.
ROUTING_SRC=https://github.com/greenspacedev/routing-comparison-nwm-nextgen-troute.git
ROUTING_REF=8b67fd49ea7b53e32c21772b2509c477ef7907e9   # medium-range

# troute-usgsdf: USGS data-assimilation dataframe (installed inside the preprocess image).
# updates_for_da's preprocess.Dockerfile clones alk05's temp_routelinkdev branch
# (git clone --depth 1, unpinned); this is that branch's head on 2026-11-13.
USGSDF_SRC=https://github.com/alk05/troute-usgsdf.git
USGSDF_REF=0a77846df17dcd0f33c4e27e18f06157dcca3fed    # temp_routelinkdev

# t-route: the routing model image
TROUTE_SRC=https://github.com/alk05/t-route.git
TROUTE_REF=ca72603b6d9f61ac5b8fba4d1841e71773d3c4ba    # update_for_feather_da

# Build fix, applied to every variant alike: t-route's requirements.txt pins numpy~=1.0
# but not pyarrow, so a fresh resolve installs pyarrow 26.0.1, which needs NumPy 2
# ("ImportError: pyarrow requires NumPy 2.0 or newer, found 1.26.4"). 23.0.0 is the
# version the working troutetest image was patched to (2026-11-09).
TROUTE_PIP_PINS="pyarrow==23.0.0"
