# Current: our improvements, taken from the local clones next to troute_bench.
#
# Local sources build whatever is COMMITTED on the named branch (pushed or not).
# Uncommitted edits are never included, so every image maps to a commit SHA.
# $CODE is the folder that holds troute_bench (set by build.sh).
DESCRIPTION="greenspacedev improvements (local clones, committed state)"

# use-our-troute-usgsdf = updates_for_da + parallel/cached NWM downloads + VPU-only restart
ROUTING_SRC="$CODE/routing-comparison-nwm-nextgen-troute"
ROUTING_REF=use-our-troute-usgsdf

# vectorized gage decoding, narrower lookback (default 0), USGS rate-limit handling
USGSDF_SRC="$CODE/troute-usgsdf"
USGSDF_REF=vectorize-routelink-gages

# No t-route changes yet: this is the same commit as the baseline, so the image is
# shared. (The local t-route clone has no local update_for_feather_da branch, only
# origin/update_for_feather_da, so this one comes from GitHub.)
TROUTE_SRC=https://github.com/greenspacedev/t-route.git
TROUTE_REF=update_for_feather_da

# Build fix, applied to every variant alike: t-route's requirements.txt pins numpy~=1.0
# but not pyarrow, so a fresh resolve installs pyarrow 26.0.1, which needs NumPy 2
# ("ImportError: pyarrow requires NumPy 2.0 or newer, found 1.26.4"). 23.0.0 is the
# version the working troutetest image was patched to (2026-11-09).
TROUTE_PIP_PINS="pyarrow==23.0.0"
