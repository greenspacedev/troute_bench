# One NWM short-range cycle on VPU 03W: 18 h, 216 five-minute steps, 135,375 segments.
# This is the longest run the pipeline supports today (medium/long range fail in
# fetch_nwm_data.py / rename_troute_inputs.py; see README "Limits").
#
# Every value can be overridden from the shell, e.g. START_TIME=202605010000 ./bench.sh ...
DESCRIPTION="VPU 03W, one short-range cycle (18 h)"
VPU=${VPU:-03W}
FORECAST_TYPE=${FORECAST_TYPE:-1}
START_TIME=${START_TIME:-202604300000}   # first cycle, YYYYMMDDHHMM (UTC)
CYCLES=${CYCLES:-1}                      # consecutive forecast cycles
CYCLE_STEP_H=${CYCLE_STEP_H:-1}          # hours between cycle start times
N_CPUS=${N_CPUS:-8}                      # t-route cpu_pool
