# chained retro v3.0 run on VPU 03W: 30 days 2022-03-12 .. 04-11 (wettest 30 days of WY2022 in 03W).
# 2022-03-12 00:00 .. 2022-04-11 00:00 UTC, 720 h, 8640 steps; ~48 MB/h of retro CHRTOUT forcing (~35 GB per run,
# deleted after repeat 1 with KEEP=first). Same window in AnA and retro; 30d within season within wy2022.
# Needs baseline-long (routing long-runs FORECAST_TYPE 12, t-route feather-da-multiloop).
# Postprocess reads one output file: run with STEPS="preprocess troute".
DESCRIPTION="VPU 03W, chained retro v3.0, 30 days 2022-03-12 .. 04-11 (wettest 30 days of WY2022 in 03W)"
VPU=${VPU:-03W}
FORECAST_TYPE=${FORECAST_TYPE:-12}
RUN_HOURS=${RUN_HOURS:-720}
MAX_LOOP_SIZE=${MAX_LOOP_SIZE:-24}
START_TIME=${START_TIME:-202203120000}
CYCLES=${CYCLES:-1}
CYCLE_STEP_H=${CYCLE_STEP_H:-720}
N_CPUS=${N_CPUS:-8}
# Long windows: USGS requests scale with rows (50k per page), and a year at 40 sites per request
# exceeds hydrotools' 20-page cap. Set here because .env's VM default (40) applies only when empty.
USGS_CHUNK=${USGS_CHUNK:-5}
