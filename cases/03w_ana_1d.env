# Chained analysis-assimilation (AnA) run on VPU 03W: 24 h of hourly AnA tm00 forcing, 288 steps.
# Needs routing-comparison with FORECAST_TYPE 5 (long-runs branch) and t-route with the
# multi-loop feather DA fix (feather-da-multiloop).
DESCRIPTION="VPU 03W, chained AnA, 24 h"
VPU=${VPU:-03W}
FORECAST_TYPE=${FORECAST_TYPE:-5}
RUN_HOURS=${RUN_HOURS:-24}
MAX_LOOP_SIZE=${MAX_LOOP_SIZE:-24}
START_TIME=${START_TIME:-202604300000}
CYCLES=${CYCLES:-1}
CYCLE_STEP_H=${CYCLE_STEP_H:-24}
N_CPUS=${N_CPUS:-8}
