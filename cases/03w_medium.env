# One NWM medium-range cycle (member 1) on VPU 03W: 240 h, 2880 five-minute steps.
# Medium range runs at 00, 06, 12, 18 UTC only. t-route holds all 2880 steps in one loop.
DESCRIPTION="VPU 03W, one medium-range cycle (240 h)"
VPU=${VPU:-03W}
FORECAST_TYPE=${FORECAST_TYPE:-2}
START_TIME=${START_TIME:-202604300000}
CYCLES=${CYCLES:-1}
CYCLE_STEP_H=${CYCLE_STEP_H:-6}
N_CPUS=${N_CPUS:-8}
