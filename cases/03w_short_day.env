# A production day on VPU 03W: the 24 hourly short-range cycles of one day, back to back.
# The NWM issues a short-range forecast every hour, so this is the sustained load one
# VPU puts on the pipeline in a day (~24 x 270 MB of NWM downloads).
DESCRIPTION="VPU 03W, 24 consecutive short-range cycles (one production day)"
VPU=${VPU:-03W}
FORECAST_TYPE=${FORECAST_TYPE:-1}
START_TIME=${START_TIME:-202604300000}
CYCLES=${CYCLES:-24}
CYCLE_STEP_H=${CYCLE_STEP_H:-1}
N_CPUS=${N_CPUS:-8}
